---
apiVersion: gateway.nginx.org/v1alpha1
kind: SnippetsFilter
metadata:
  name: sf-{{.Index}}
  namespace: {{.Namespace}}
spec:
  snippets:
    - context: http.server.location
      value: |
        add_header X-Route-{{.Index}} "0" always;
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: route-{{.Index}}
  namespace: {{.Namespace}}
spec:
  parentRefs:
    - name: {{.Gateway}}
      sectionName: http
  hostnames:
    - "r{{.Index}}.example.com"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /r{{.Index}}
      filters:
        - type: ExtensionRef
          extensionRef:
            group: gateway.nginx.org
            kind: SnippetsFilter
            name: sf-{{.Index}}
      backendRefs:
        - name: {{.Backend}}
          port: 80
